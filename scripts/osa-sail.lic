      7142022 => ["Sleeping Drake Harbor", "Drake Harbor, Pier Five"],
      7142023 => ["Sleeping Drake Harbor", "Drake Harbor, Pier Five"],
      7142024 => ["Sleeping Drake Harbor", "Drake Harbor, Pier Five"],
      7142025 => ["Sleeping Drake Harbor", "Drake Harbor, Pier Five"],
      7150106 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150107 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150108 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150109 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150110 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150111 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150112 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150113 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150114 => ["Sailor's Grief", "Talon Isle, Docks"],
      7150118 => ["Sailor's Grief", "Talon Isle, Docks"],
      14150001 => ["Nielira Harbor", "Nielira Harbor, Acistira Pier"],
      14150002 => ["Nielira Harbor", "Nielira Harbor, Acistira Pier"],
      14150003 => ["Nielira Harbor", "Nielira Harbor, Acistira Pier"],
      14150004 => ["Nielira Harbor", "Nielira Harbor, Acistira Pier"],
      14150005 => ["Nielira Harbor", "Nielira Harbor, Acistira Pier"],
      14150006 => ["Nielira Harbor", "Nielira Harbor, Naefira Pier"],
      14150007 => ["Nielira Harbor", "Nielira Harbor, Naefira Pier"],
      14150008 => ["Nielira Harbor", "Nielira Harbor, Naefira Pier"],
      14150009 => ["Nielira Harbor", "Nielira Harbor, Naefira Pier"],
      14150010 => ["Nielira Harbor", "Nielira Harbor, Naefira Pier"],
      14150011 => ["Nielira Harbor", "Nielira Harbor, Taerethil Pier"],
      14150012 => ["Nielira Harbor", "Nielira Harbor, Taerethil Pier"],
      14150013 => ["Nielira Harbor", "Nielira Harbor, Taerethil Pier"],
      14150014 => ["Nielira Harbor", "Nielira Harbor, Taerethil Pier"],
      14150015 => ["Nielira Harbor", "Nielira Harbor, Taerethil Pier"],
      14150016 => ["Nielira Harbor", "Nielira Harbor, Resaeun Pier"],
      14150017 => ["Nielira Harbor", "Nielira Harbor, Resaeun Pier"],
      14150018 => ["Nielira Harbor", "Nielira Harbor, Resaeun Pier"],
      14150019 => ["Nielira Harbor", "Nielira Harbor, Resaeun Pier"],
      14150020 => ["Nielira Harbor", "Nielira Harbor, Resaeun Pier"],
      14150021 => ["Nielira Harbor", "Nielira Harbor, Aelerine Pier"],
      14150022 => ["Nielira Harbor", "Nielira Harbor, Aelerine Pier"],
      14150023 => ["Nielira Harbor", "Nielira Harbor, Aelerine Pier"],
      14150024 => ["Nielira Harbor", "Nielira Harbor, Aelerine Pier"],
      14150025 => ["Nielira Harbor", "Nielira Harbor, Aelerine Pier"],
    }.freeze
    # rubocop:enable Layout/HashAlignment

    HEADINGS = %w[n ne e se s sw w nw].freeze
    HEADING_WORD = {
      'n' => 'north', 'ne' => 'northeast', 'e' => 'east', 'se' => 'southeast',
      's' => 'south', 'sw' => 'southwest', 'w' => 'west', 'nw' => 'northwest'
    }.freeze
    WORD_HEADING = HEADING_WORD.invert.freeze
    DELTA = {
      'n' => [0, -1], 'ne' => [1, -1], 'e' => [1, 0], 'se' => [1, 1],
      's' => [0, 1], 'sw' => [-1, 1], 'w' => [-1, 0], 'nw' => [-1, -1]
    }.freeze
    BACK = { 'n' => 's', 'ne' => 'sw', 'e' => 'w', 'se' => 'nw', 's' => 'n', 'sw' => 'ne', 'w' => 'e', 'nw' => 'se' }.freeze

    # Deck names by offset from the hull's base game room number. Every hull shares one
    # layout; a hull simply has fewer of the offsets. The Man O' War inserts a Mid Deck,
    # which shifts its Forward Deck and Bow.
    STANDARD_DECKS = ['Main Deck', 'Helm', 'Cargo Hold', "Captain's Quarters", "Crow's Nest",
                      'Mess Hall', 'Forward Deck', 'Crew Quarters', 'Bow', 'Social Room'].freeze
    MAN_O_WAR_DECKS = ['Main Deck', 'Helm', 'Cargo Hold', "Captain's Quarters", "Crow's Nest",
                       'Mess Hall', 'Mid Deck', 'Crew Quarters', 'Forward Deck', 'Social Room',
                       'Bow', "Forward Crow's Nest"].freeze

    # hull title => base game room number (negative), decks present (by offset), decks that
    # carry a sail, the launch fee the dock handler quotes, and the noun the game uses.
    # The sloop is recorded; the other hulls come from the community ship table.
    HULLS = {
      'Sloop'      => { base: -7117010, decks: STANDARD_DECKS[0, 5], masts: ['Main Deck'], fee: 5000, noun: 'sloop' },
      'Brigantine' => { base: -7117020, decks: STANDARD_DECKS[0, 8], masts: ['Main Deck', 'Forward Deck'], fee: 7500, noun: 'brigantine' },
      'Carrack'    => { base: -7117030, decks: STANDARD_DECKS[0, 9], masts: ['Main Deck', 'Forward Deck'], fee: 7500, noun: 'carrack' },
      'Galleon'    => { base: -7117040, decks: STANDARD_DECKS[0, 10], masts: ['Main Deck', 'Forward Deck'], fee: 10_000, noun: 'galleon' },
      'Frigate'    => { base: -7117050, decks: STANDARD_DECKS[0, 10], masts: ['Main Deck', 'Forward Deck'], fee: 10_000, noun: 'frigate' },
      "Man O' War" => { base: -7117100, decks: MAN_O_WAR_DECKS, masts: ['Main Deck', 'Mid Deck', 'Forward Deck'], fee: 12_500, noun: 'man' }
    }.freeze
    VERIFIED_HULLS = ['Sloop'].freeze
    # Lich appends " - <room id>" to the title when room-id display is on; the deck name
    # stops before it.
    HULL_TITLE = /^\[(Sloop|Brigantine|Carrack|Galleon|Frigate|Man O' War), ([^\]]+?)(?: - -?\d+)?\]/.freeze
    ENEMY_TITLE = /^\[Enemy Ship, /.freeze

    # deck => { neighbouring deck => command }. Main Deck's east and Forward Deck's west have
    # two candidates; Deck.step picks the one the hull actually has.
    DECK_GRAPH = {
      'Main Deck'           => { 'Helm' => 'west', "Crow's Nest" => 'up', 'Cargo Hold' => 'down', 'Forward Deck' => 'east', 'Mid Deck' => 'east' },
      'Helm'                => { 'Main Deck' => 'east', "Captain's Quarters" => 'go door' },
      "Captain's Quarters"  => { 'Helm' => 'out' },
      "Crow's Nest"         => { 'Main Deck' => 'down' },
      'Cargo Hold'          => { 'Main Deck' => 'up', 'Crew Quarters' => 'west', 'Mess Hall' => 'east' },
      'Mess Hall'           => { 'Cargo Hold' => 'west', 'Social Room' => 'east' },
      'Social Room'         => { 'Mess Hall' => 'west' },
      'Crew Quarters'       => { 'Cargo Hold' => 'east' },
      'Mid Deck'            => { 'Main Deck' => 'west', 'Forward Deck' => 'east' },
      'Forward Deck'        => { 'Main Deck' => 'west', 'Mid Deck' => 'west', 'Bow' => 'east', "Forward Crow's Nest" => 'up' },
      'Bow'                 => { 'Forward Deck' => 'west' },
      "Forward Crow's Nest" => { 'Forward Deck' => 'down' }
    }.freeze

    # Names SHIP INFO uses for a port when they differ from the port table's.
    PORT_ALIASES = {
      'isle of ornath' => 'Sleeping Drake Harbor'
    }.freeze

    def self.port_named(text)
      return nil if text.nil? || text.strip.empty?
      want = text.strip.downcase
      return PORT_ALIASES[want] if PORT_ALIASES.key?(want)
      PORTS.keys.find { |n| n.downcase == want } ||
        PORTS.keys.find { |n| n.downcase.start_with?(want) } ||
        PORTS.keys.find { |n| n.downcase.split(/[\s']+/).any? { |w| w.start_with?(want) } }
    end

    def self.port_looking(adjective)
      PORTS.find { |_, p| p[:looks] == adjective }&.first
    end

    def self.port_of_pier(uid)
      PIERS[uid]&.first
    end

    def self.piers_titled(title)
      PIERS.select { |_, (_, t)| t == title }.keys.sort
    end

    def self.port_of_ocean_room(uid)
      PORTS.find { |_, p| p[:uid] == uid }&.first
    end

    def self.toward(uid, heading)
      room = OCEAN[uid]
      return nil unless room
      room[2 + HEADINGS.index(heading)]
    end

    # A heading runs true when it reaches the adjacent grid cell and that cell leads back.
    def self.runs_true?(uid, heading)
      there = toward(uid, heading)
      return false unless there && OCEAN[there]
      dx, dy = DELTA[heading]
      here = OCEAN[uid]
      OCEAN[there][0] == here[0] + dx && OCEAN[there][1] == here[1] + dy && toward(there, BACK[heading]) == uid
    end
  end

  # ------------------------------------------------------------------
  # Course: Dijkstra over (room, heading held). The ship moves one room per tick whatever
  # the wheel does, and turning it fits inside a tick, so the fewest rooms is the fastest
  # course. Turns only break ties between courses of equal length: ROOM_COST is larger
  # than any number of turns a course could have.
  # ------------------------------------------------------------------

  module Course
    ROOM_COST = 1024
    TURN_COST = 1
    STILL = nil

    # @return [Array<Array(String, Array<Integer>)>, nil] legs of [heading, rooms entered], nil if unreachable
    def self.plot(from, to, holding: STILL)
      return [] if from == to
      return nil unless Data::OCEAN[from] && Data::OCEAN[to]

      dist = { [from, holding] => 0 }
      prev = {}
      heap = MinHeap.new
      heap.push(0, [from, holding])
      until heap.empty?
        cost, (room, held) = heap.pop
        next if cost > dist[[room, held]]
        return legs_from(prev, [room, held]) if room == to

        Data::HEADINGS.each do |h|
          next unless Data.runs_true?(room, h)
          nxt = Data.toward(room, h)
          next if Data::ODD_ROOMS.include?(nxt) && nxt != to
          c = cost + ROOM_COST + (h == held ? 0 : TURN_COST)
          key = [nxt, h]
          next if dist[key] && dist[key] <= c
          dist[key] = c
          prev[key] = [room, held]
          heap.push(c, key)
        end
      end
      nil
    end

    class MinHeap
      def initialize
        @a = []
      end

      def empty?
        @a.empty?
      end

      def push(cost, item)
        @a << [cost, item]
        i = @a.size - 1
        while i > 0
          parent = (i - 1) / 2
          break if @a[parent][0] <= @a[i][0]
          @a[parent], @a[i] = @a[i], @a[parent]
          i = parent
        end
      end

      def pop
        top = @a.first
        last = @a.pop
        unless @a.empty?
          @a[0] = last
          i = 0
          loop do
            l = 2 * i + 1
            r = l + 1
            m = i
            m = l if l < @a.size && @a[l][0] < @a[m][0]
            m = r if r < @a.size && @a[r][0] < @a[m][0]
            break if m == i
            @a[m], @a[i] = @a[i], @a[m]
            i = m
          end
        end
        top
      end
    end

    def self.legs_from(prev, state)
      path = []
      while prev[state]
        path.unshift(state)
        state = prev[state]
      end
      legs = []
      path.each do |room, heading|
        if legs.last && legs.last[0] == heading
          legs.last[1] << room
        else
          legs << [heading, [room]]
        end
      end
      legs
    end

    def self.rooms(legs)
      legs.sum { |_, r| r.size }
    end

    # Wheel turns the course needs. The first leg is free when it continues the heading held.
    def self.turns(legs, holding: STILL)
      legs.size - (legs.first && legs.first[0] == holding ? 1 : 0)
    end

    # About 60 s from DEPART to the first move, then 20 s a room at full speed, from live
    # sloop recordings. Timing on the test server is slower and fixed and must not be used
    # here; every timing number comes from live. Wheel turns happen between moves and add
    # nothing.
    def self.seconds(legs)
      60 + 20 * rooms(legs)
    end

    def self.describe(legs)
      legs.map { |h, r| "#{Data::HEADING_WORD[h]} x#{r.size}" }.join(', ')
    end
  end

  # ------------------------------------------------------------------
  # Deck: which hull, which deck, how to walk between decks.
  # ------------------------------------------------------------------

  module Deck
    def self.parse_title(title)
      m = Data::HULL_TITLE.match(title.to_s)
      m ? [m[1], m[2]] : nil
    end

    def self.hull_by_name(text)
      return nil if text.nil?
      want = text.strip.downcase.delete("'")
      Data::HULLS.keys.find { |h| h.downcase.delete("'") == want || h.downcase.delete("'").start_with?(want) }
    end

    # Shortest list of [command, deck] steps from one deck to another on this hull.
    def self.route(hull, from, to)
      decks = Data::HULLS.fetch(hull)[:decks]
      return [] if from == to
      return nil unless decks.include?(from) && decks.include?(to)

      # With a Mid Deck between them, Main Deck's east is the Mid Deck and Forward Deck's
      # west is the Mid Deck, not each other.
      skip = decks.include?('Mid Deck') ? { 'Main Deck' => 'Forward Deck', 'Forward Deck' => 'Main Deck' } : {}
      prev = { from => nil }
      queue = [from]
      until queue.empty?
        deck = queue.shift
        break if deck == to
        Data::DECK_GRAPH.fetch(deck, {}).each do |nxt, cmd|
          next if skip[deck] == nxt
          next unless decks.include?(nxt) && !prev.key?(nxt)
          prev[nxt] = [deck, cmd]
          queue << nxt
        end
      end
      return nil unless prev.key?(to)

      steps = []
      deck = to
      while prev[deck]
        back, cmd = prev[deck]
        steps.unshift([cmd, deck])
        deck = back
      end
      steps
    end
  end

  # ------------------------------------------------------------------
  # Lines: what the game says. Ship, fitting and sail names are free text throughout.
  # ------------------------------------------------------------------

  module Lines
    SHIP_OWNED       = /^\s*(SLOOP|BRIGANTINE|CARRACK|GALLEON|FRIGATE|MAN O' WAR)\s+(.+?)\s*$/i.freeze
    DOCKED_AT        = /Docked at:\s*(.+?)\s*$/.freeze
    SHIP_NAME        = /^Ship Name:\s*(.+?)\s*$/.freeze
    HULL_COLOR       = /^Hull Color:\s*(.+?)\s*$/.freeze
    HULL_MATERIAL    = /^Hull Material:\s*(.+?)\s*$/.freeze
    SHIP_DOCKED      = /Ship is currently docked at:\s*(.+?)\s*$/.freeze
    NAMEPLATE        = /it reads, "(.+?)"/.freeze
    FEE              = /You're about to launch your .+?  It'll cost about ([\d,]+) silvers to get it ready\./.freeze
    PIER_NAMED       = /"Looks like we have some space around the (.+?)\."/.freeze
    ALREADY_DOCKED   = /"What\?  You already have a ship docked at the (.+?)!"/.freeze
    REFUSED          = /come back to me when you have enough money/.freeze
    NEEDS_BOATSWAIN  = /Your ship was recently damaged or has fees associated with it/.freeze
    BOARDED          = /You make your way (?:up|across) the .+? gangplank/.freeze
    PLANK_DEPLOYS    = /gangplank suddenly protrudes|you already deployed it|there is already a .+? gangplank deployed/.freeze
    CANT_GO          = /Where are you trying to go|I could not find what you were referring to/.freeze
    WATCHING         = /You begin to watch the ocean waters|You are already watching the ocean/.freeze
    FLAG_IS          = /^The .+? is currently flying (.+?)\./.freeze
    FLAG_RAISED      = /just raised a (.+?) flag atop|Your ship is now flying|already flying/.freeze
    FLAG_COOLDOWN    = /Time until flag can be changed: (\d+) (minute|second)/.freeze
    PLANK_UP         = /pull it back up on the deck|sending it back up on the deck|retracting your gangplank/.freeze
    PLANK_DOWN       = /good shove, deploying it below/.freeze
    SAIL_STATE       = /sail (?:until it is (at half mast|fully open)|is (raised halfway|fully raised)|is already (lowered|raised) as far as it can go)[.!]/.freeze
    SAIL_FULL        = /until it is fully open|is already lowered as far as it can go/.freeze
    WIND_FILLED      = /ripples and billows with the sudden gust of wind/.freeze
    SAIL_LOOK        = /currently raised|half mast|fully lowered|filled with magical wind/.freeze
    SAIL_WINDED      = /filled with magical wind/.freeze
    ANCHOR_UP        = /as the anchor settles against the hull|The anchor is already up!/.freeze
    ANCHOR_PUSHING   = /begin to push|You manage to push|you shove/.freeze
    ANCHOR_DOWN      = /chain is unfurled and the anchor is deployed|anchor is already released|You must raise your anchor|releasing the anchor|strains against the deployed anchor|anchor can be heard rattling down the side/.freeze
    DEPART_CONFIRM   = /Repeat this command within 30 seconds to confirm/i.freeze
    DEPARTED         = /drifts out into the open sea|You're already out on the ocean!/.freeze
    DEPART_PLANK     = /You can't set sail without retracting your gangplank!/.freeze
    NOT_CAPTAIN      = /Only the Captain can begin your voyage/.freeze
    MOVED            = /^The .+? (?:drifts slowly (\w+), its sails fully raised|cuts through the ocean, heading (\w+?)(?: at full speed)?)\./.freeze
    STEERED          = /do your best to steer the ship (.+?)\.|wheel is already turned that way!/.freeze
    STEER_REFUSED    = /you'd have better luck/.freeze
    ARRIVED          = /drifts steadily toward the (.+?) port\.  Shouts are heard from the piers nearby directing the .+? to (.+?)\.  As the /.freeze

    SWELL            = /A large swell crashes into the side of the/.freeze
    WHEEL_SPUN       = /suddenly drifts from its course as the|wheel slowly turns off course\.|Aimless, the .+? rocks idly in the ocean waters/.freeze
    RIGGING_LOOSE    = /The sound of ropes coming free of the rigging/.freeze
    ENEMY_SIGHTED    = /carves through the ocean toward your|drums of war|materializes next to your ship!|glowing green waters|booming of cannon fire erupts from the enemy/.freeze
    ENEMY_LEFT       = /changes course away from your/.freeze
    GRAPPLED         = /Several ropes with claw-shaped hooks|The sides of the .+? collide against your/.freeze
    STOWING          = /A collection of dock workers can be heard shouting from nearby/.freeze
    WAIT             = /^\.\.\.wait (\d+) seconds?\.|^Sorry, you may only type ahead/.freeze
  end

  # ------------------------------------------------------------------
  # Watcher: a DownstreamHook that turns the unprompted lines above into events the trip
  # reads between steps. Everything else passes through untouched.
  # ------------------------------------------------------------------

  class Watcher
    attr_reader :events

    def initialize
      @events = []
      @mutex = Mutex.new
    end

    def hook
      proc do |server_string|
        see(server_string)
        server_string
      end
    end

    # The hook hands over the raw server string, markup and line ending included.
    def see(raw)
      line = raw.gsub(/<[^>]+>/, '').strip
      event =
        if (m = Lines::MOVED.match(line)) then [:moved, Data::WORD_HEADING[m[1] || m[2]]]
        elsif (m = Lines::ARRIVED.match(line)) then [:arrived, m[1], m[2]]
        elsif Lines::SWELL.match?(line) then [:anchor_down]
        elsif Lines::RIGGING_LOOSE.match?(line) then [:sails_furled]
        elsif Lines::WHEEL_SPUN.match?(line) then [:heading_lost]
        elsif Lines::GRAPPLED.match?(line) then [:grappled]
        elsif Lines::ENEMY_SIGHTED.match?(line) then [:enemy]
        elsif Lines::ENEMY_LEFT.match?(line) then [:enemy_left]
        elsif Lines::STOWING.match?(line) then [:stowing]
        end
      @mutex.synchronize { @events << event } if event
      event
    end

    def take_all
      @mutex.synchronize do
        out = @events.dup
        @events.clear
        out
      end
    end

    def requeue(events)
      @mutex.synchronize { @events.unshift(*events) }
    end
  end

  # ------------------------------------------------------------------
  # Game: the only place that talks to Lich. Specs replace it.
  # ------------------------------------------------------------------

  class Game
    HOOK = 'osa-sail'

    def log(msg)
      respond "[osa-sail] #{msg}"
    end

    def title
      XMLData.room_title
    end

    def npcs
      GameObj.npcs || []
    end

    def objects
      GameObj.loot || []
    end

    # Wait out roundtime, send, wait up to timeout for a line matching expect, wait out
    # roundtime again. A "...wait" answer is retried.
    def send(command, expect, timeout: 5, tries: 3)
      tries.times do
        waitrt?
        line = dothistimeout(command, timeout, Regexp.union(expect, Lines::WAIT))
        waitrt?
        if line && (m = Lines::WAIT.match(line))
          sleep((m[1] || 1).to_f + 0.2)
          next
        end
        return line
      end
      nil
    end

    def quiet(command, start_pattern, timeout: 5)
      Lich::Util.issue_command(command, start_pattern, /<prompt/, timeout: timeout, quiet: true, silent: true)
    end

    def walk_to(uid)
      ids = Map.ids_from_uid(uid)
      return false if ids.nil? || ids.empty?
      return true if Room.current && Room.current.id == ids.first

      Script.run('go2', "#{ids.first} --disable-confirm")
      Room.current && Room.current.id == ids.first
    end

    def current_uid
      Room.current&.uid&.first
    end

    def spell_known?(num)
      Spell[num].known?
    end

    def level
      Stats.level
    end

    def cast(num, target)
      Spell[num].cast(target)
    end

    # One poll interval while the trip waits for the ship to move.
    def idle
      sleep 0.5
    end

    def wait(seconds)
      sleep seconds
    end

    def watch(watcher)
      DownstreamHook.add(HOOK, watcher.hook)
      before_dying { DownstreamHook.remove(HOOK) }
    end

    def unwatch
      DownstreamHook.remove(HOOK)
    end

    def confirm?(question)
      respond question
      respond "[osa-sail] ;send yes to sail, ;send no to stop"
      deadline = Time.now + 60
      while Time.now < deadline
        line = get?
        return true if line =~ /^yes$/i
        return false if line =~ /^no$/i
        sleep 0.2
      end
      false
    end
  end

  # ------------------------------------------------------------------
  # Trip
  # ------------------------------------------------------------------

  class Halt < StandardError; end

  class Trip
    WIND_SPELLS = [612, 912].freeze
    # Breeze (612) lasts (3 * level / 9) * 9 seconds, integer arithmetic: about 3 s a level,
    # rounded down to a multiple of 9. Call Wind (912) is not measured yet; 90 s is the
    # community scripts' recast interval. Recast one move early so the wind never lapses.
    WIND_FALLBACK = 90
    WIND_MARGIN = 20

    def self.wind_duration(spell, level)
      spell == 612 ? (3 * level.to_i / 9) * 9 : WIND_FALLBACK
    end
    FIRST_MOVE_WAIT = 120
    MOVE_WAIT = 60

    attr_reader :hull, :deck, :position, :held

    # With --flag-wait, wait for the white flag's cooldown when it is at most this long.
    # Sailing under no flag can spawn enemy ships; the default is to go anyway and outrun them.
    FLAG_WAIT_MAX = 10 * 60
    # Headings that would not hold before trying another, and before giving up.
    STUCK_RETRIES = 3
    STUCK_LIMIT = 12

    def initialize(game, target, call_wind: false, confirm: true, watch: true, hull: nil, flag_wait: false)
      @game = game
      @target = target
      @call_wind = call_wind
      @confirm = confirm
      @watch = watch
      @flag_wait = flag_wait
      @hull = hull
      @watcher = Watcher.new
      @held = Course::STILL
      @position = nil
      @last_wind = nil
    end

    def run
      goal = Data::PORTS.fetch(@target)
      locate
      # SHIP INFO's port name, or failing that the port of the pier we are standing on.
      departure = @docked_at || Data.port_of_pier(@game.current_uid)
      unless departure
        said = @docked_at_text ? " (it says #{@docked_at_text.inspect}, which is not a port I know)" : ''
        raise Halt, "SHIP INFO does not say which port your #{@hull} is docked at#{said}"
      end
      raise Halt, "your #{@hull} is already at #{@target}" if departure == @target

      legs = Course.plot(Data::PORTS.fetch(departure)[:uid], goal[:uid])
      raise Halt, "no course from #{departure} to #{@target}" unless legs

      plan = "#{@hull} from #{departure} to #{@target}: #{Course.rooms(legs)} rooms, #{legs.size} turns, about #{Course.seconds(legs) / 60} min (#{Course.describe(legs)})"
      plan += "  [#{@hull} deck layout not yet verified in game]" unless Data::VERIFIED_HULLS.include?(@hull)
      if @confirm && !@game.confirm?("[osa-sail] #{plan}")
        @game.log 'stopped'
        return :declined
      end
      @game.log plan

      @game.watch(@watcher)
      begin
        retrieve_and_board(departure) unless @aboard
        make_ready
        voyage(Data::PORTS.fetch(departure)[:uid], goal[:uid])
        disembark
      ensure
        @game.unwatch
      end
      :arrived
    end

    # -- where are we -------------------------------------------------

    # Aboard, the deck title gives the hull. Ashore or aboard, SHIP INFO gives the port the
    # ship is docked at; aboard a ship that is at sea there is no plan to make.
    def locate
      raise Halt, 'you are aboard an enemy ship' if Data::ENEMY_TITLE.match?(@game.title)
      if (parsed = Deck.parse_title(@game.title))
        @hull, @deck = parsed
        @aboard = true
      else
        @aboard = false
      end
      read_ship_info
      raise Halt, 'SHIP INFO names no ship of yours; pass --hull=<name>' unless @hull
      raise Halt, "your #{ship_label} is under repair; wait for the boatswain to finish" if @under_repair
      raise Halt, "your #{ship_label} owes fees; see the boatswain before sailing" if @owes_fees
    end

    # SHIP INFO lists every ship owned with the port it is docked at; SHIP INFO <hull> adds
    # the ship's name, its hull colour and material (how it reads on a pier), and whether
    # it owes fees or is under repair, which the dock handler would otherwise refuse over.
    def read_ship_info
      lines = @game.quiet('ship info', /Ships you own|Please enter a valid ship/) || []
      lines.each do |l|
        text = l.gsub(/<[^>]+>/, '')
        next unless (m = Lines::SHIP_OWNED.match(text))
        found = Deck.hull_by_name(m[1])
        next if @hull && found != @hull
        @hull ||= found
        @docked_at_text = Lines::DOCKED_AT.match(m[2])&.[](1)
        @docked_at = Data.port_named(@docked_at_text)
      end
      return unless @hull

      detail = @game.quiet("ship info #{Data::HULLS.fetch(@hull)[:noun]}", /SHIP INFO|Please enter a valid ship/) || []
      detail.each do |l|
        text = l.gsub(/<[^>]+>/, '').strip
        if (m = Lines::SHIP_NAME.match(text)) then @ship_name = m[1]
        elsif (m = Lines::HULL_COLOR.match(text)) then @hull_color = m[1] unless m[1] =~ /not set/i
        elsif (m = Lines::HULL_MATERIAL.match(text)) then @hull_material = m[1] unless m[1] =~ /not set/i
        elsif (m = Lines::SHIP_DOCKED.match(text)) then @docked_at = Data.port_named(m[1]) || @docked_at
        elsif text =~ /fees associated/ && text !~ /does not/ then @owes_fees = true
        elsif text =~ /under repair/ && text !~ /not currently under repair/ then @under_repair = true
        end
      end
    end

    def ship_label
      @ship_name ? "#{@hull} #{@ship_name.inspect}" : @hull
    end

    # -- retrieve and board -------------------------------------------

    def retrieve_and_board(departure)
      port = Data::PORTS.fetch(departure)
      raise Halt, "could not walk to the #{departure} dock handler" unless @game.walk_to(port[:handler])

      pier = ask_handler(departure)
      rooms = Data.piers_titled(pier)
      raise Halt, "the handler named #{pier.inspect}, which is not in the pier table" if rooms.empty?

      chosen = nil
      deadline = Time.now + 60
      until chosen || Time.now > deadline
        rooms.each do |uid|
          @game.walk_to(uid)
          chosen = pick_ship(@game.objects.select { |o| ship_object?(o) })
          break if chosen
        end
        sleep 5 unless chosen
      end
      raise Halt, "could not find your #{ship_label} at #{pier}" unless chosen

      board(chosen)
    end

    def ask_handler(departure)
      npc = @game.npcs.find { |n| n.noun =~ /^(handler|master|warden)$/ && (n.name =~ /dock/ || n.noun == 'warden') }
      raise Halt, 'no dock handler here' unless npc

      answer = Regexp.union(Lines::FEE, Lines::PIER_NAMED, Lines::ALREADY_DOCKED, Lines::REFUSED, Lines::NEEDS_BOATSWAIN)
      2.times do
        line = @game.send("ask ##{npc.id} about retrieve #{Data::HULLS.fetch(@hull)[:noun]}", answer, timeout: 6)
        raise Halt, 'the dock handler did not answer' unless line
        if (m = Lines::PIER_NAMED.match(line) || Lines::ALREADY_DOCKED.match(line))
          pier = m[1]
          # Only one ship is out at a time. "Already docked" at another port's pier means a
          # different ship of yours is out there, and it must be stored before this one sails.
          port_of_pier = Data.port_of_pier(Data.piers_titled(pier).first)
          if port_of_pier && port_of_pier != departure
            raise Halt, "another ship of yours is already out at #{pier} (#{port_of_pier}); store it there first (ASK <dock handler> TO STORE <hull>, twice)"
          end
          return pier
        end
        if Lines::NEEDS_BOATSWAIN.match?(line)
          raise Halt, "your #{@hull} is damaged or owes fees; see the boatswain (ASK <boatswain> TO FIX #{Data::HULLS.fetch(@hull)[:noun].upcase}, twice), wait about 5 minutes, then sail again"
        end
        if Lines::REFUSED.match?(line)
          fee = Data::HULLS.fetch(@hull)[:fee]
          raise Halt, "the handler wants about #{fee} silver (or a note) to launch your #{@hull}"
        end
      end
      raise Halt, 'the dock handler quoted a fee twice and never named a pier'
    end

    # Other people's ships share the piers. An object is a candidate when it is the right
    # hull ("a man o' war" carries the noun "war", so the name is checked too) and carries
    # the hull colour and material SHIP INFO gave, when they are set.
    def ship_object?(obj)
      name = obj.name.to_s.downcase
      hull = Data::HULLS.fetch(@hull)
      return false unless obj.noun == hull[:noun] || name.include?(@hull.downcase)
      return false if @hull_color && !name.include?(@hull_color.downcase)
      return false if @hull_material && !name.include?(@hull_material.downcase)

      true
    end

    # One customised candidate is ours. Otherwise (an uncustomised hull looks like anyone's,
    # or several match) LOOK at each and compare the nameplate with the ship's name.
    def pick_ship(candidates)
      return nil if candidates.empty?
      return candidates.first if candidates.size == 1 && (@hull_color || @hull_material)
      return candidates.first unless @ship_name

      candidates.find do |obj|
        line = @game.send("look ##{obj.id}", Lines::NAMEPLATE, timeout: 4)
        line && Lines::NAMEPLATE.match(line)[1] == @ship_name
      end
    end

    # GO <ship> works whether the gangplank is out or not: the game deploys it on the way.
    # Recorded answers are "gangplank suddenly protrudes ... You make your way up" and
    # "you already deployed it! ... You make your way across".
    # GO <ship> deploys the plank and boards when it is up. When it is already down the game
    # only says so ("you realize there is already a slender gangplank deployed!") and the
    # boarding is GO GANGPLANK.
    def board(ship)
      3.times do
        @game.send("go ##{ship.id}", Regexp.union(Lines::BOARDED, Lines::PLANK_DEPLOYS, Lines::CANT_GO), timeout: 6)
        sleep 1
        break if Deck.parse_title(@game.title)
        @game.send('go gangplank', Regexp.union(Lines::BOARDED, Lines::CANT_GO), timeout: 6)
        sleep 1
        break if Deck.parse_title(@game.title)
      end
      parsed = Deck.parse_title(@game.title)
      raise Halt, "could not board your #{ship_label}" unless parsed
      @hull, @deck = parsed
      @aboard = true
    end

    # -- make ready ---------------------------------------------------

    def make_ready
      go_to 'Main Deck'
      raise_white_flag
      go_to 'Main Deck'
      @game.send('pull gangplank', Regexp.union(Lines::PLANK_UP, /gangplank/), timeout: 5)
      lower_all_sails
      call_wind if @call_wind
      raise_anchor
      depart
    end

    def raise_white_flag
      line = @game.send('ship flag', Lines::FLAG_IS, timeout: 4)
      return if line && Lines::FLAG_IS.match(line)[1] =~ /white/
      go_to "Crow's Nest"
      3.times do
        line = @game.send('ship flag white', Regexp.union(Lines::FLAG_RAISED, Lines::FLAG_COOLDOWN), timeout: 5)
        return unless line && (m = Lines::FLAG_COOLDOWN.match(line))

        seconds = m[1].to_i * (m[2] == 'minute' ? 60 : 1)
        unless @flag_wait && seconds <= FLAG_WAIT_MAX
          @game.log "the flag cannot be changed for #{m[1]} #{m[2]}s; sailing under the current flag (enemy ships may spawn)"
          return
        end
        @game.log "the flag cannot be changed for #{m[1]} #{m[2]}s; waiting for white"
        @game.wait(seconds + 5)
      end
      @game.log 'could not raise the white flag; sailing under the current flag'
    end

    def lower_all_sails
      Data::HULLS.fetch(@hull)[:masts].each do |mast_deck|
        go_to mast_deck
        4.times do
          line = @game.send('lower sail', Lines::SAIL_STATE, timeout: 6)
          break if line.nil? || Lines::SAIL_FULL.match?(line)
        end
      end
    end

    def call_wind
      spell = WIND_SPELLS.find { |s| @game.spell_known?(s) }
      unless spell
        @game.log 'neither Breeze (612) nor Call Wind (912) is known; sailing without wind'
        @call_wind = false
        return
      end
      @wind_spell = spell
      Data::HULLS.fetch(@hull)[:masts].each do |mast_deck|
        go_to mast_deck
        look = @game.send('look sail', Lines::SAIL_LOOK, timeout: 4)
        next if look && Lines::SAIL_WINDED.match?(look)
        @game.cast(spell, 'sail')
      end
      @last_wind = Time.now
    end

    def raise_anchor
      go_to 'Helm'
      12.times do
        line = @game.send('push capstan', Regexp.union(Lines::ANCHOR_UP, Lines::ANCHOR_PUSHING, Lines::ANCHOR_DOWN), timeout: 6)
        return if line && Lines::ANCHOR_UP.match?(line)
      end
      raise Halt, 'the anchor would not come up'
    end

    def depart
      go_to 'Helm'
      answer = Regexp.union(Lines::DEPARTED, Lines::DEPART_CONFIRM, Lines::DEPART_PLANK, Lines::NOT_CAPTAIN, Lines::ANCHOR_DOWN)
      6.times do
        line = @game.send('depart', answer, timeout: 8)
        raise Halt, 'only the Captain can begin the voyage' if line && Lines::NOT_CAPTAIN.match?(line)
        if line && Lines::DEPART_PLANK.match?(line)
          go_to 'Main Deck'
          @game.send('pull gangplank', Lines::PLANK_UP, timeout: 5)
          go_to 'Helm'
          next
        end
        if line && Lines::ANCHOR_DOWN.match?(line)
          raise_anchor
          next
        end
        if line && Lines::DEPARTED.match?(line)
          @watcher.take_all
          # WATCH OCEAN only works once the ship is on the water; in port it answers
          # "I could not find what you were referring to."
          @game.send('watch ocean', Regexp.union(Lines::WATCHING, Lines::CANT_GO), timeout: 4) if @watch
          return
        end
      end
      raise Halt, 'DEPART did not take'
    end

    # -- voyage -------------------------------------------------------

    def voyage(departure_uid, goal_uid)
      @position = departure_uid
      @held = Course::STILL
      first_move = true
      started = Time.now

      loop do
        raise Halt, 'voyage exceeded 90 minutes' if Time.now - started > 90 * 60
        handle_events
        return if @docked

        if @position == goal_uid
          steer('port')
          if (look = wait_for(:arrived, MOVE_WAIT * 2))
            @game.log "docked at #{Data.port_looking(look) || look}"
            @docked = true
            return
          end
          handle_events
          return if @docked
          raise Halt, 'turned toward port but the ship did not dock' if @held == 'port'
          next
        end

        # Follow the plotted course room by room. Re-plot only when the ship lands somewhere
        # other than the next room on it: re-plotting after every move, with "keep the
        # heading held" as the tie-break, let the ship wander along an equal-length route
        # instead of the one it announced.
        if @steps.nil? || @steps.empty?
          legs = Course.plot(@position, goal_uid, holding: @held)
          raise Halt, "lost: no course from #{@position} to #{goal_uid}" unless legs
          @steps = legs.flat_map { |h, rooms| rooms.map { |r| [h, r] } }
        end
        want = heading_that_might_hold(goal_uid, @steps.first[0])
        steer(want) if want != @held
        recast_wind

        heading = wait_for(:moved, first_move ? FIRST_MOVE_WAIT : MOVE_WAIT)
        first_move = false
        next unless heading # events (swell, rigging) are handled at the top of the loop

        nxt = Data.toward(@position, heading)
        raise Halt, "lost: the ship went #{Data::HEADING_WORD[heading]} from #{@position}, which the chart has no water for" unless nxt
        @position = nxt
        @stuck = 0
        @stuck_headings = []
        if @steps.first[1] == nxt
          @steps.shift
        else
          @game.log "off course at #{nxt}; re-plotting"
          @steps = nil
        end
      end
    end

    # Under pursuit the wheel "slowly turns off course" and the ship sits still. In testing
    # the same heading failed eight times while a different one moved at once, so after a
    # few failures try the other true headings from this room, nearest-to-goal first, and
    # give the wheel back once nothing holds.
    def heading_that_might_hold(goal_uid, want)
      @stuck ||= 0
      @stuck_headings ||= []
      return want if @stuck < STUCK_RETRIES
      raise Halt, 'the ship will not hold any course here (under attack?)' if @stuck >= STUCK_LIMIT

      @stuck_headings << want unless @stuck_headings.include?(want)
      options = Data::HEADINGS.select { |h| Data.runs_true?(@position, h) && !@stuck_headings.include?(h) }
      ranked = options.map { |h| [Course.plot(Data.toward(@position, h), goal_uid), h] }
                      .reject { |legs, _| legs.nil? }
                      .sort_by { |legs, _| Course.rooms(legs) }
      return want if ranked.empty?

      choice = ranked.first[1]
      @game.log "#{Data::HEADING_WORD[want]} will not hold; trying #{Data::HEADING_WORD[choice]}"
      choice
    end

    def steer(heading)
      go_to 'Helm'
      word = heading == 'port' ? 'port' : Data::HEADING_WORD[heading]
      3.times do
        line = @game.send("turn wheel #{word}", Regexp.union(Lines::STEERED, Lines::STEER_REFUSED), timeout: 10)
        raise Halt, "the wheel refused #{word}" if line && Lines::STEER_REFUSED.match?(line)
        if line
          @held = heading
          return
        end
      end
      raise Halt, "the wheel would not turn #{word}"
    end

    # One game event often arrives as two lines ("wheel slowly turns off course" then
    # "Aimless, the sloop rocks idly"), so a batch is handled once per kind.
    def handle_events
      @watcher.take_all.uniq(&:first).each do |event, *args|
        case event
        when :anchor_down
          @game.log 'a swell dropped the anchor; raising it'
          raise_anchor
          @held = Course::STILL
        when :sails_furled
          @game.log 'the rigging came loose; lowering every sail'
          lower_all_sails
          @held = Course::STILL
        when :heading_lost
          @stuck = (@stuck || 0) + 1
          @game.log "the wheel turned off course (#{@stuck}); re-steering"
          @held = Course::STILL
        when :arrived
          port = Data.port_looking(args[0]) || args[0]
          @game.log "docked at #{port}, #{args[1]}"
          @docked = true
        when :grappled
          raise Halt, 'an enemy ship has grappled us'
        when :enemy
          @game.log 'an enemy ship is near' unless @enemy_near
          @enemy_near = true
        when :enemy_left
          @game.log 'the enemy ship changed course away'
          @enemy_near = false
        end
      end
    end

    # Waits for one event of the given kind, leaving others queued. Returns its first
    # argument (the heading for :moved), true for argument-less events, or nil on timeout.
    def wait_for(kind, timeout)
      deadline = Time.now + timeout
      while Time.now < deadline
        pending = @watcher.take_all
        hit = pending.find { |e| e[0] == kind }
        @watcher.requeue(pending.reject { |e| e.equal?(hit) })
        return hit[1] || true if hit
        return nil if pending.any? { |e| %i[anchor_down sails_furled heading_lost grappled].include?(e[0]) }
        @game.idle
      end
      nil
    end

    def recast_wind
      return unless @call_wind && @last_wind
      due = Trip.wind_duration(@wind_spell, @game.level) - WIND_MARGIN
      return unless Time.now - @last_wind > due
      call_wind
      go_to 'Helm'
    end

    # -- disembark ----------------------------------------------------

    def disembark
      go_to 'Main Deck'
      @game.send('push gangplank', Regexp.union(Lines::PLANK_DOWN, /gangplank/), timeout: 5)
      line = @game.send('go gangplank', Regexp.union(Lines::BOARDED, Lines::CANT_GO), timeout: 8)
      raise Halt, 'could not get ashore' unless line && Lines::BOARDED.match?(line)
      sleep 1
      @game.log "ashore at #{@game.title}"
    end

    # -- deck walking -------------------------------------------------

    def go_to(deck)
      parsed = Deck.parse_title(@game.title)
      raise Halt, "not aboard (#{@game.title})" unless parsed
      @deck = parsed[1]
      return if @deck == deck

      steps = Deck.route(@hull, @deck, deck)
      raise Halt, "no way from #{@deck} to #{deck} on a #{@hull}" unless steps
      steps.each do |cmd, expect|
        @game.send(cmd, /^\[/, timeout: 5)
        parsed = Deck.parse_title(@game.title)
        raise Halt, "walked #{cmd} from #{@deck} and ended at #{@game.title}, not #{expect}" unless parsed && parsed[1] == expect
        @deck = expect
      end
    end
  end

  # ------------------------------------------------------------------
  # CLI
  # ------------------------------------------------------------------

  module CLI
    def self.help
      respond <<~HELP
        ;osa-sail <port>            retrieve or board your ship, sail to <port>, step onto the pier
        ;osa-sail route <port>      show the course only
        ;osa-sail ports             list the ports
        options: --call-wind  --no-confirm  --no-watch  --flag-wait  --hull=<name>
        ports: #{Data::PORTS.keys.join(', ')}
      HELP
    end

    def self.main(args, game = Game.new)
      words = args.dup
      opts = { call_wind: false, confirm: true, watch: true, hull: nil, flag_wait: false }
      words.reject! do |w|
        case w
        when '--call-wind' then opts[:call_wind] = true
        when '--no-confirm' then opts[:confirm] = false
        when '--no-watch' then opts[:watch] = false
        when '--flag-wait' then opts[:flag_wait] = true
        when /^--hull=(.+)$/ then opts[:hull] = Deck.hull_by_name(Regexp.last_match(1))
        else next false
        end
        true
      end

      case words.first
      when nil, 'help' then return help
      when 'ports' then return respond(Data::PORTS.keys.join(', '))
      when 'route'
        return route(words[1..].join(' '), game)
      end

      target = Data.port_named(words.join(' '))
      return respond("[osa-sail] no port matches #{words.join(' ').inspect}; try ;osa-sail ports") unless target

      trip = Trip.new(game, target, **opts)
      begin
        result = trip.run
        game.log "arrived at #{target}" if result == :arrived
      rescue Halt => e
        game.log "stopped: #{e.message}. The wheel is yours."
      end
    end

    def self.route(text, game)
      target = Data.port_named(text)
      return respond("[osa-sail] no port matches #{text.inspect}") unless target

      from = Data.port_of_pier(game.current_uid)
      from ||= Data::PORTS.keys.find { |n| Data::PORTS[n][:handler] == game.current_uid }
      return respond('[osa-sail] stand on a pier or at a dock handler to plot a route') unless from

      legs = Course.plot(Data::PORTS[from][:uid], Data::PORTS[target][:uid])
      return respond("[osa-sail] no course from #{from} to #{target}") unless legs

      respond "[osa-sail] #{from} to #{target}: #{Course.rooms(legs)} rooms, #{legs.size} turns, about #{Course.seconds(legs) / 60} min"
      respond "[osa-sail] #{Course.describe(legs)}"
    end
  end
end

OsaSail::CLI.main(Script.current.vars[1..] || []) unless defined?(OSA_SAIL_NO_AUTORUN)
